{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "declaration": true,
    "outDir": "dist/sdk",
    "rootDir": "sdk/src",
    "allowJs": true,
    "checkJs": false,
    "skipLibCheck": true
  },
  "include": ["sdk/src/**/*.ts", "sdk/src/**/*.mjs"]
}
