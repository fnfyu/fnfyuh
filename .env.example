# WSL/Docker build settings
NODE_VERSION=22.22.2
RUST_VERSION=1.85.1
# Mirrors work well from WSL in mainland China; replace with official registries if needed.
NPM_REGISTRY=https://registry.npmmirror.com
CARGO_MIRROR=sparse+https://rsproxy.cn/index/

# Use a WSL path when running Compose from WSL, for example:
# HARNESS_WORKSPACE=/home/<user>/src/fnfyuh
HARNESS_WORKSPACE=.

# Runtime execution backend (local-trusted-host, container, or vm). Container/vm
# modes fail closed if the configured Docker engine/image is unavailable.
HARNESS_EXECUTION_BACKEND=local-trusted-host
HARNESS_CONTAINER_RUNTIME=docker
# Use an immutable digest in deployments; this tag is only a local example.
HARNESS_CONTAINER_IMAGE=node:22-bookworm-slim
HARNESS_CONTAINER_ISOLATION=container
HARNESS_CONTAINER_MEMORY=512m
HARNESS_CONTAINER_CPUS=2
HARNESS_CONTAINER_PIDS=128

# OpenAI-compatible provider. Keep real values in the process secret store.
HARNESS_MODEL=gpt-5.4
HARNESS_MODEL_ENDPOINT=
HARNESS_MODEL_API_KEY=
HARNESS_MODEL_TIMEOUT_MS=120000

# OpenAI Codex OAuth bridge. OAuth credentials are stored in this local file;
# no ChatGPT cookies or session tokens are used.
HARNESS_CODEX_BRIDGE=apps/gateway/codex-bridge.mjs
HARNESS_CODEX_OAUTH_FILE=.runtime/openai-codex-oauth.json
HARNESS_CODEX_NODE=node
HARNESS_CODEX_TIMEOUT_MS=120000
PI_OAUTH_CALLBACK_HOST=127.0.0.1

# Optional local Web/IDE gateway.
HARNESS_GATEWAY_HOST=127.0.0.1
HARNESS_GATEWAY_PORT=8787
# Set for any non-loopback gateway deployment; the Web client reads the same token
# from localStorage key `harness.gateway.token`.
HARNESS_GATEWAY_TOKEN=

# Optional local proxy for Docker's OpenAI/Codex traffic. For the WSL host's
# Clash/Mihomo listener, use http://127.0.0.1:7897.
HARNESS_HTTP_PROXY=
HARNESS_HTTPS_PROXY=
HARNESS_ALL_PROXY=
HARNESS_NO_PROXY=localhost,127.0.0.1,::1
